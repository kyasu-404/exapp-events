<?xml version="1.0" encoding="UTF-8"?>
<info>
  <id>exapp_events</id>
  <name>Мероприятия</name>
  <summary>Мероприятия из Excel в Nextcloud Calendar</summary>
  <description>Синхронизация XLSX, публичный календарь и email-напоминания. Управление только администраторами.</description>
  <version>0.1.0</version>
  <licence>agpl</licence>
  <author>exapp-events contributors</author>
  <namespace>ExAppEvents</namespace>
  <category>organization</category>
  <dependencies><nextcloud min-version="34" max-version="35"/></dependencies>
  <external-app>
    <docker-install>
      <registry>docker.io</registry>
      <image>exapp-events</image>
      <image-tag>0.1.0</image-tag>
    </docker-install>
    <routes>
      <route><url>^/api/.*$</url><verb>GET,POST,PUT,DELETE</verb><access_level>ADMIN</access_level></route>
      <route><url>^/(js|css)/.*$</url><verb>GET</verb><access_level>ADMIN</access_level></route>
      <route><url>^/img/.*$</url><verb>GET</verb><access_level>PUBLIC</access_level></route>
    </routes>
  </external-app>
</info>
